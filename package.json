{
  "name": "@lumen/react",
  "version": "0.2.0",
  "description": "Lumen — a futuristic, space-themed React design system.",
  "type": "module",
  "license": "MIT",
  "author": "Krithiga Rani Murugesan",
  "keywords": [
    "design-system",
    "react",
    "tailwind",
    "space",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/lumen.css -o ./dist/styles.css --minify",
    "build": "npm run build:js && npm run build:css",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:css && vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krithigarani/lumen-design-system.git"
  },
  "homepage": "https://lumen-design-system-ten.vercel.app",
  "bugs": {
    "url": "https://github.com/krithigarani/lumen-design-system/issues"
  }
}
